generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id         String      @id @default(uuid())
  externalId String // O ID que vem de fora (para idempotência)
  type       String
  payload    Json
  status     EventStatus @default(RECEIVED)
  attempts   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  logs EventLog[]

  @@index([externalId])
  @@index([status])
}

model EventLog {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id])
  level     Level    @default(INFO)
  message   String
  createdAt DateTime @default(now()) @map("created_at")
}

model Rule {
  id         String   @id @default(cuid())
  targetType String   @map("target_type") // Aplica-se apenas a eventos desse tipo
  condition  Json // Ex: {"field": "amount", "operator": ">", "value": 100}
  action     Json // Ex: {"type": "send_email", "target": "admin"}
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
}

enum Level {
  INFO
  ERROR
  WARN
}

enum EventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}
